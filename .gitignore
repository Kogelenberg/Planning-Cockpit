# Portable Node.js-runtime (lokaal gedownload, niet nodig in git)
.runtime/

# Dependencies (installeer opnieuw met `npm install`)
node_modules/

# Build-output (regenereren met `npm run build`)
web/dist/

# Lokale runtime-data — bevat je echte agenda-inhoud en notities, hoort nooit
# in een (zeker publieke) git-repo terecht te komen.
data/*.json
data/*.json.tmp
data/*.pid

# Logs
logs/
*.log

# macOS
.DS_Store

# Machine-eigen instellingen (bv. agenda-namen op een andere Mac) — hoort niet
# in git, want dat is per-machine/per-persoon config. Zie .env.local.example.
.env.local

# Git-bundles zijn alleen een transportmiddel tussen twee Macs zonder
# gedeelde GitHub-toegang, geen onderdeel van de code zelf.
*.bundle

# Machine-specifiek: elk mens/elke Mac heeft zijn eigen pad hierin,
# dus dit hoort niet gedeeld te worden via git (zie ook .env.local).
com.vankogelenberg.planningcockpit.plist
