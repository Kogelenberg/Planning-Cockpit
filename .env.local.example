# Kopieer dit bestand naar `.env.local` en vul je EIGEN agenda-namen in zoals
# ze in Fantastical staan (precies zo, hoofdletters maken niet uit). Dit
# bestand zelf (.env.local) wordt nooit meegecommit naar git — zo kan dezelfde
# code op meerdere Macs draaien, elk met hun eigen agenda's, zonder dat er ooit
# een merge-conflict of gelekte agenda-naam in de git-historie komt.
#
# Alleen agenda's die hier staan worden ooit opgehaald, getoond of gewijzigd
# door Planning Cockpit — zie de "Welke agenda's zijn zichtbaar"-sectie in
# README.md. Laat dit bestand weg (of leeg) om de standaardwaarden uit
# server/src/config.js te gebruiken.

ALLOWED_CALENDAR_NAMES=Privé,School,Hogeschool Utrecht
WORK_CALENDAR_NAMES=School,Hogeschool Utrecht
PERSONAL_CALENDAR_NAMES=Privé
DEFAULT_NEW_EVENT_CALENDAR_NAME=Privé

# "Call niet doorgegaan"-knop: om dit uur verzet naar de eerste vrije tijd
# (binnen dit venster) volgens deze agenda — zie README "Call niet doorgegaan".
NO_SHOW_MOVE_HOUR=17
NO_SHOW_TARGET_CALENDAR_NAME=School
FREE_SLOT_WINDOW_START_HOUR=8
FREE_SLOT_WINDOW_END_HOUR=18

# Optioneel, zelden nodig:
# PORT=4173
# POLL_INTERVAL_MS=180000
# FANTASTICAL_MCP_PATH=/pad/naar/FantasticalMCP
